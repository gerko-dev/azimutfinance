# Supabase — voir https://supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Cle SECRETE — uniquement cote serveur, jamais dans NEXT_PUBLIC_*
# Ne JAMAIS committer ce fichier renomme en .env.local
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend — emails transactionnels (validation Premium, rejet, etc.)
# Cree une cle sur https://resend.com/api-keys (free tier : 3000 emails/mois)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Expediteur. Avant verification du domaine azimutfinance.com sur Resend,
# laisser le defaut "AzimutFinance <onboarding@resend.dev>" (envoi vers tes
# emails de test uniquement). Une fois le DNS configure, passer a
# "AzimutFinance <noreply@azimutfinance.com>".
RESEND_FROM=AzimutFinance <onboarding@resend.dev>

# URL publique de l'app (utilisee dans les liens des emails)
NEXT_PUBLIC_APP_URL=https://azimutfinance.com

# Cron — secret partage entre l'app et cron-job.org / Vercel Cron.
# Genere un random string long, ex. `openssl rand -hex 32`.
# Le cron appelle GET /api/cron/premium-expiry-reminder avec header
# `Authorization: Bearer <CRON_SECRET>` une fois par jour.
CRON_SECRET=changeme-long-random-string
