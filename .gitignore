# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
!certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch/debug
tmp_*
.tmp_ppt/

# rapports générés (artefacts d'export, non versionnés)
/exports/

# python
__pycache__/
*.pyc

# Excel autosave next to .xlsb (Microsoft Office)
*.xlk

# Documents de travail deposes a la racine — jamais versionnes.
#
# Ce depot est PUBLIC. Y pousser un inventaire de FCP, un etat de valeur
# liquidative, une balance generale ou des transactions inter-fonds les rendrait
# consultables par n'importe qui, et un depot GitHub public est indexe, forke et
# mis en cache : la suppression ulterieure ne repare rien.
#
# La regle est ancree sur la racine (/) pour ne pas toucher les documents
# legitimement versionnes sous data/ — avis de prix CHPH, notices publiques.
/*.xlsx
/*.pptx
/*.pdf
/*.docx

# Archives et scripts jetables
/data/historique_sika/*.rar
/_tmp_*.mjs
/_test_*
